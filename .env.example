# Supabase project configuration. The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend test delivery. A custom sending domain is not required for this MVP.
RESEND_API_KEY=
EMAIL_FROM=
OUTREACH_TEST_RECIPIENT=
RESEND_WEBHOOK_SECRET=

# n8n Gmail test delivery. Both values are server-only.
N8N_EMAIL_WEBHOOK_URL=https://creatorflow.app.n8n.cloud/webhook/creatorflow-gmail-test
N8N_EMAIL_WEBHOOK_SECRET=

# Legacy local-only integration gate; provider routes now require workspace auth.
OUTREACH_DEV_TOKEN=

# Optional remote persistent libSQL/Turso database. Without this, a local
# SQLite-compatible database is created under .creatorflow/outreach.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Meta Business Login for Instagram (Instagram API with Instagram Login).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
INTEGRATION_ENCRYPTION_KEY=
